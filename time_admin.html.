    function saveGameAction() {
        const name = document.getElementById('admin-game-name').value;
        const pin = document.getElementById('admin-game-pin').value;
        const discord = document.getElementById('admin-game-discord').value;
        const start = document.getElementById('admin-game-start').value;
        const kiDays = parseInt(document.getElementById('admin-ki-days').value);
        const pvpDays = parseInt(document.getElementById('admin-pvp-days').value);
        const copyPhase2 = document.getElementById('admin-copy-phase2').checked;

        let phase1 = [];
        let phase2 = [];

        for(let i=0; i<5; i++) {
            phase1.push({
                name: `Alarm ${i+1}`,
                minutes: document.getElementById(`admin-phase1-mins-${i}`).value || "0",
                seconds: document.getElementById(`admin-phase1-secs-${i}`).value || "0",
                alarmType: document.getElementById(`admin-phase1-type-${i}`).value,
                active: true
            });

            if(copyPhase2) {
                phase2.push({
                    name: `Alarm ${i+1}`,
                    minutes: document.getElementById(`admin-phase1-mins-${i}`).value || "0",
                    seconds: document.getElementById(`admin-phase1-secs-${i}`).value || "0",
                    alarmType: document.getElementById(`admin-phase1-type-${i}`).value,
                    active: true
                });
            } else {
                phase2.push({
                    name: `Alarm ${i+1}`,
                    minutes: document.getElementById(`admin-phase2-mins-${i}`).value || "0",
                    seconds: document.getElementById(`admin-phase2-secs-${i}`).value || "0",
                    alarmType: document.getElementById(`admin-phase2-type-${i}`).value,
                    active: true
                });
            }
        }

        if(!name || !pin || !start) {
            alert('Bitte Rundenname, PIN und Startzeit angeben!');
            return;
        }

        if(editingGameId) {
            const game = games.find(g => g.id === editingGameId);
            if(game) {
                game.name = name;
                game.pin = pin;
                game.discord = discord;
                game.start = start;
                game.kiDays = kiDays;
                game.pvpDays = pvpDays;
                game.copyPhase2 = copyPhase2;
                game.phase1 = phase1;
                game.phase2 = phase2;
            }
            alert('Runde erfolgreich aktualisiert!');
            resetAdminForm();
        } else {
            games.push({ id: Date.now(), name, pin, discord, start, kiDays, pvpDays, copyPhase2, phase1, phase2 });
            alert('Runde erfolgreich erstellt!');
            resetAdminForm();
        }
        saveGames();
        renderAdminGames();
    }

