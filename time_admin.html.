    function startGlobalClockTicker() {
        setInterval(() => {
            if(!activeGame) return;
            
            const startTime = new Date(activeGame.start).getTime();
            const kiTarget = startTime + (activeGame.kiDays * 24 * 60 * 60 * 1000);
            const pvpTarget = kiTarget + (activeGame.pvpDays * 24 * 60 * 60 * 1000);

            updateClockDisplay('ki', activeGame.kiDays === 0 ? startTime : kiTarget, activeGame.kiDays === 0);
            updateClockDisplay('pvp', pvpTarget, false);
            
            calculateAlarmPreviews('phase1', activeGame.kiDays === 0 ? startTime : kiTarget, 'ki');
            calculateAlarmPreviews('phase2', pvpTarget, 'pvp');
        }, 1000);
    }

    function updateClockDisplay(type, targetTime, isNone) {
        const display = document.getElementById(`${type}-clock-display`);
        const label = document.getElementById(`${type}-target-label`);

        if(isNone && type === 'ki') {
            display.innerText = "KEINE KI-PHASE";
            label.innerText = "Sofortiger PvP-Schutz aktiv";
            return;
        }

        const now = new Date().getTime();
        const diff = targetTime - now;
        label.innerText = `Endzeit: ${new Date(targetTime).toLocaleString()}`;

        if(diff <= 0) {
            display.innerText = "BEENDET";
            return;
        }

        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));

        display.innerText = `${days > 0 ? days + 'T ' : ''}${String(hours).padStart(2,'0')}:${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}`;
    }

    function calculateAlarmPreviews(phaseKey, targetTime, bannerType) {
        const previewContainer = document.getElementById(`${bannerType}-alarms-preview`);
        const nextAblaufContainer = document.getElementById(`${bannerType}-next-Ablauf`);
        let cfg = playerRoundConfig[activeGame.id];
        let phaseConfigs = cfg[phaseKey];

        const now = new Date().getTime();
        let closestDiff = Infinity;
        let closestText = "--:--:--";

        previewContainer.innerHTML = phaseConfigs.map((c, idx) => {
            const isActive = c.active !== false; // Standardmäßig aktiv

            if (isActive) {
                const mins = parseInt(c.minutes) || 0;
                const secs = parseInt(c.seconds) || 0;
                const totalOffsetMs = (mins * 60 + secs) * 1000;
                const alarmTriggerTime = targetTime - totalOffsetMs;
                
                const diffToAlarm = alarmTriggerTime - now;
                if(diffToAlarm > 0 && diffToAlarm < closestDiff) {
                    closestDiff = diffToAlarm;
                    let h = Math.floor((diffToAlarm % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    let m = Math.floor((diffToAlarm % (1000 * 60 * 60)) / (1000 * 60));
                    let s = Math.floor((diffToAlarm % (1000 * 60)) / 1000);
                    closestText = `${h > 0 ? h + ':' : ''}${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
                }
            }

            let timeDisplay = `${parseInt(c.minutes) || 0}m ${parseInt(c.seconds) || 0}s`;
            return `
                <div class="alarm-badge-mini ${isActive ? '' : 'inactive'}">
                    <button class="alarm-status-toggle ${isActive ? 'active' : ''}" onclick="toggleAlarmActive('${phaseKey}', ${idx}, event)" title="${isActive ? 'Aktiv (Klick zum Deaktivieren)' : 'Deaktiviert (Klick zum Aktivieren)'}">
                        ${isActive ? '✓' : '✕'}
                    </button>
                    <span onclick="openEditAlarmModal('${phaseKey}', ${idx})" style="cursor: pointer;">⏰ <b>${timeDisplay}</b> (${c.alarmType})</span>
                </div>
            `;
        }).join('');

        if(nextAblaufContainer) {
            nextAblaufContainer.innerText = `Nächster Ablauf: ${closestText}`;
        }
    }

